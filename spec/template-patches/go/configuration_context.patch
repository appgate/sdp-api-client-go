diff --git a/go/configuration.mustache b/go/configuration.mustache
--- a/go/configuration.mustache
+++ b/go/configuration.mustache
@@ -19,6 +19,17 @@
 }
 
 var (
+	// ContextAcceptHeader takes a string and use it as Accept value
+	ContextAcceptHeader = contextKey("acceptheader")
+
+	{{^hasHttpBearerMethods}}
+	// ContextAccessToken takes a string oauth2 access token as authentication for the request.
+	// Patched in for spec versions that do not declare an HTTP bearer security
+	// scheme (openapi-generator v7 emits its own copy when they do); gated off
+	// in that case so ContextAccessToken is not redeclared.
+	ContextAccessToken = contextKey("accesstoken")
+
+	{{/hasHttpBearerMethods}}
 	{{#hasOAuthMethods}}
 	// ContextOAuth2 takes an oauth2.TokenSource as authentication for the request.
 	ContextOAuth2 = contextKey("token")
